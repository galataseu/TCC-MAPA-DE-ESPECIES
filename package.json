{
  "name": "bootleaf-express-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "django:run": "python3 backend/manage.py runserver 8000",
    "django:seed": "python3 backend/manage.py seed_db",
    "django:migrate": "python3 backend/manage.py migrate",
    "prisma:studio": "npx prisma studio",
    "prisma:pull": "npx prisma db pull",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "npx prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "^4.22.2",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
