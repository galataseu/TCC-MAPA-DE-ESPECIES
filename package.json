{
  "name": "bootleaf-express-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "django:setup": "cd backend && python3 -m venv venv && ./venv/bin/pip install -r requirements.txt",
    "django:run": "./backend/venv/bin/python backend/manage.py runserver 8000",
    "django:seed": "./backend/venv/bin/python backend/manage.py seed_db",
    "django:migrate": "./backend/venv/bin/python backend/manage.py migrate",
    "full": "concurrently \"npm run dev\" \"npm run django:run\"",
    "prisma:studio": "npx prisma studio",
    "prisma:pull": "npx prisma db pull",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "npx prisma db seed",
    "fix:coords": "node scripts/fix_marker_coords.js",
    "fix:coords:dry": "node scripts/fix_marker_coords.js --dry-run",
    "enrich:images": "node scripts/enrich_images.js",
    "vercel-build": "npx prisma generate"
  },
  "overrides": {
    "shell-quote": "1.8.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "all": "^0.0.0",
    "approve": "^0.0.12",
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.4",
    "debug": "^2.6.9",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pug": "^3.0.3",
    "scripts": "^0.1.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.12.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
