# Configurações do Banco de Dados (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tcc_geodb

# Configurações Django
NODE_ENV=development
JWT_SECRET=django-insecure-default-key-change-me

# Configurações Express
PORT=3000

# E-mail de alerta de mudança de status (SMTP genérico; ex. Gmail com senha de app).
# O .env NÃO sobe para a Vercel: cadastre as mesmas chaves em
# Settings → Environment Variables (Production + Preview + Development) e faça
# redeploy. Diagnóstico em produção: GET /api/v1/notificacoes/status e
# POST /api/v1/notificacoes/test { "email": "voce@exemplo.com" }.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=seu@gmail.com, SMTP_PASS=senha-de-app-sem-espacos,
# SMTP_FROM=Gralha dos Ventos <seu@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
