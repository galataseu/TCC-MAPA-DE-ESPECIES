#animalCreateModal.modal.fade(tabindex="-1", role="dialog")
  .modal-dialog
    .modal-content
      .modal-header
        h4.modal-title Cadastrar Animal
        button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
      .modal-body
        form#animal-create-form
          input#animal-lat(type="hidden", name="lat")
          input#animal-lng(type="hidden", name="lng")
          .mb-3
            label.form-label(for="nome_comum") Nome Comum
            input#nome_comum.form-control(type="text", name="nome_comum", required)
          .mb-3
            label.form-label(for="nome_cientifico") Nome Científico
            input#nome_cientifico.form-control(type="text", name="nome_cientifico", required)
          .mb-3
            label.form-label(for="classe") Classe
            select#classe.form-control(name="classe", required)
              option(value="Mammalia") Mammalia
              option(value="Aves") Aves
              option(value="Reptilia") Reptilia
              option(value="Amphibia") Amphibia
              option(value="Chondrichthyes") Chondrichthyes
              option(value="Osteichthyes") Osteichthyes
          .mb-3
            label.form-label(for="nivel_extincao_id") Nível de Extinção
            select#nivel_extincao_id.form-control(name="nivel_extincao_id", required)
          .mb-3
            label.form-label(for="biomas_ids") Biomas
            select#biomas_ids.form-control(name="biomas_ids", multiple, required)
          .mb-3
            label.form-label(for="regiao_id") Região
            select#regiao_id.form-control(name="regiao_id")
              option(value="") Selecione uma região (opcional)
          .mb-3
            label.form-label(for="animal_imagem") Imagem
            input#animal_imagem.form-control(type="file", name="animal_imagem", accept="image/*")
          button.btn.btn-primary.w-100(type="submit") Cadastrar Animal

#configModal.modal.fade(tabindex="-1", role="dialog")
  .modal-dialog
    .modal-content
      .modal-header
        h4.modal-title Configurações de Exibição
        button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
      .modal-body
        .form-check
          input#toggle-textures.form-check-input(type="checkbox", checked)
          label.form-check-label(for="toggle-textures") Habilitar texturas dos biomas (ícones)
      .modal-footer
        button.btn.btn-primary(type="button", data-bs-dismiss="modal") Fechar

#legendModal.modal.fade(tabindex="-1", role="dialog")
  .modal-dialog
    .modal-content
      .modal-header
        h4.modal-title Legenda
        button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
      .modal-body
        p
          i.fa-solid.fa-square(style="color: #1E7552;")
          |  Paraná (Roxo)
        p
          i.fa-solid.fa-square(style="color: #FF0000;")
          |  Santa Catarina (Vermelho)
        p
          i.fa-solid.fa-square(style="color: #FFFF00;")
          |  Rio Grande do Sul (Amarelo)
        p
          i.fa-solid.fa-square(style="color: #2ECC71; opacity: 0.6;")
          |  Mata Atlântica (Corte Regional)
      .modal-footer
        button.btn.btn-primary(type="button", data-bs-dismiss="modal") Fechar

#loginModal.modal.fade(tabindex="-1", role="dialog")
  .modal-dialog.modal-sm
    .modal-content
      .modal-header
        h4.modal-title Acesso ao Sistema
        button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
      .modal-body
        form#login-form
          .mb-3
            label.form-label(for="login-username") Usuário
            input#login-username.form-control(type="text", required)
          .mb-3
            label.form-label(for="login-password") Senha
            input#login-password.form-control(type="password", required)
          button.btn.btn-primary.w-100(type="submit") Entrar
        hr
        p.text-center
          | Não tem uma conta? 
          br
          a#go-to-register(href="#") Cadastre-se aqui

#registerModal.modal.fade(tabindex="-1", role="dialog")
  .modal-dialog.modal-sm
    .modal-content
      .modal-header
        h4.modal-title Cadastro
        button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
      .modal-body
        form#register-form
          .mb-3
            label.form-label(for="reg-username") Usuário
            input#reg-username.form-control(type="text", required)
          .mb-3
            label.form-label(for="reg-password") Senha
            input#reg-password.form-control(type="password", required)
          button.btn.btn-success.w-100(type="submit") Criar Conta
        hr
        p.text-center
          | Já possui conta? 
          br
          a#go-to-login(href="#") Fazer login
