//- ----------------------------------------------------------------------------
//- 3) Lógica: auto-abertura, cookie de sessão, Esc, foco preso + preview do mapa
//- ----------------------------------------------------------------------------
script.
  (function () {
    'use strict';
    // Chave exigida na especificação (cookie DE SESSÃO: some ao fechar o navegador).
    var STORAGE_KEY = 'hideWelcomeScreen';
    function welcomeGetCookie(name) {
      try {
        var parts = document.cookie.split(';');
        for (var i = 0; i < parts.length; i++) {
          var kv = parts[i].split('=');
          if (kv[0] && kv[0].trim() === name) return decodeURIComponent((kv[1] || '').trim());
        }
      } catch (e) {}
      return '';
    }
    function welcomeSetSessionCookie(name, value) {
      try {
        if (value == null) document.cookie = name + '=;path=/;SameSite=Lax;expires=Thu, 01 Jan 1970 00:00:00 GMT';
        else document.cookie = name + '=' + encodeURIComponent(value) + ';path=/;SameSite=Lax';
      } catch (e) {}
    }
    var ANIM_MS = 230;
    // Mesmos tiles dark do mapa principal (o navegador reaproveita o cache).
    var PREVIEW_TILE_URL = 'https://{s}.basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}.png?key=cb1_3l5t_1_889f4489a3fb5fb5051816e3';
    var PREVIEW_TILE_FALLBACK_URL = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
    // Tour cinematográfico do preview (Sul do Brasil).
    var PREVIEW_TOUR = [
      { lat: -25.4284, lng: -49.2733 },
      { lat: -27.5954, lng: -48.5480 },
      { lat: -30.0346, lng: -51.2177 }
    ];
    var PREVIEW_TOUR_MS = 6000;

    var overlay, scrollEl, closeX, closeBtn, checkbox, hint, fade, lastFocused;
    var previewMap = null, tourTimer = null, tourIdx = 0, previewStarted = false, previewRetries = 0;

    function $(id) { return document.getElementById(id); }

    function isOpen() {
      return overlay && !overlay.classList.contains('d-none');
    }

    // Seletores focáveis para o "focus trap" (acessibilidade).
    // O preview é interativo: os botões de zoom entram na ordem de Tab.
    function focusables() {
      return Array.prototype.slice.call(
        overlay.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter(function (el) { return el.offsetParent !== null; });
    }

    // --- Preview ao vivo: o MESMO mapa original (tiles, centro e zoom
    // iniciais), totalmente funcional: arrastar, duplo-clique, botões de
    // zoom e toque. Só o scroll do mouse fica desligado de propósito para
    // não sequestrar a rolagem da página; o tour para no 1º toque do usuário.
    var PREVIEW_CENTER = { lat: -27.5, lng: -51.5 };
    var PREVIEW_ZOOM = 6;
    var tourStoppedByUser = false;
    function initPreview() {
      if (previewStarted) return;
      // Leaflet ainda carregando (CDN lento)? Tenta de novo enquanto aberto.
      if (typeof L === 'undefined') {
        if (isOpen() && previewRetries < 20) {
          previewRetries++;
          setTimeout(initPreview, 500);
        }
        return;
      }
      previewStarted = true;
      var el = $('welcome-map-preview');
      if (!el) return;
      try {
        previewMap = L.map(el, {
          center: [PREVIEW_CENTER.lat, PREVIEW_CENTER.lng],
          zoom: PREVIEW_ZOOM,
          minZoom: 5,
          maxBounds: [[-34.0, -58.0], [-22.0, -47.0]],
          maxBoundsViscosity: 1.0,
          zoomControl: true,
          attributionControl: false,
          dragging: true,
          scrollWheelZoom: false,
          doubleClickZoom: true,
          boxZoom: true,
          keyboard: false,
          tap: true,
          zoomAnimation: true
        });
        var baseTiles = L.tileLayer(PREVIEW_TILE_URL, { maxZoom: 19, subdomains: 'abcd', errorTileUrl: PREVIEW_TILE_FALLBACK_URL }).addTo(previewMap);
        // 1º tile carregado: esconde o placeholder (nunca cobre o mapa).
        // Se algum tile falhar, recalcula o tamanho (caso de container 0x0).
        baseTiles.on('tileload', function () {
          try {
            var fb = el.parentElement && el.parentElement.querySelector('.welcome-preview-fallback');
            if (fb) fb.classList.add('is-hidden');
          } catch (e) {}
        });
        baseTiles.on('tileerror', function () {
          try { previewMap.invalidateSize(); } catch (e) {}
        });
        loadPreviewZonas();
        // 1ª interação física do usuário cancela o tour (entrega o controle).
        previewMap.on('dragstart', stopTourForGood);
        try {
          el.addEventListener('mousedown', stopTourForGood);
          el.addEventListener('touchstart', stopTourForGood, { passive: true });
          el.addEventListener('wheel', stopTourForGood, { passive: true });
        } catch (e) {}
        // O container sai de display:none no meio de animação + fontes que
        // ainda carregam: o tamanho muda depois do init e parte dos tiles
        // fica sem renderizar (faixa cinza). Recalcula várias vezes e
        // observa mudanças futuras de tamanho.
        function refreshPreviewSize() {
          try { if (previewMap) previewMap.invalidateSize(); } catch (e) {}
        }
        [80, 300, 700, 1400, 2500].forEach(function (ms) {
          setTimeout(function () { try { if (isOpen()) refreshPreviewSize(); } catch (e) {} }, ms);
        });
        try {
          if (typeof ResizeObserver !== 'undefined') {
            var previewRO = new ResizeObserver(function () { refreshPreviewSize(); });
            previewRO.observe(el);
          }
        } catch (e) {}
        try {
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () { refreshPreviewSize(); }).catch(function () {});
          }
        } catch (e) {}
        startTour();
      } catch (e) { previewMap = null; }
    }

    // Zonas de preservação no preview (mesmas cores do mapa principal).
    // Leve de propósito: só contorno + preenchimento, sem labels/máscara.
    function loadPreviewZonas() {
      loadPreviewBase();
    }

    // Réplica do mapa original no preview: biomas (cor + textura),
    // máscara fora do Sul, contornos dos estados, zonas, animais e ONGs.
    // Tudo não-interativo e com limite de marcadores (é só uma prévia).
    var PREVIEW_STATUS_COLORS = { ex: '#403E4C', ew: '#831F34', cr: '#FF4068', en: '#FF6426', vu: '#FFA63A', nt: '#217757', lc: '#1A5FB4', dd: '#555555' };
    function previewStatusColor(sigla) {
      var s = String(sigla || 'dd').toLowerCase();
      return PREVIEW_STATUS_COLORS[s] || '#555555';
    }
    function injectPreviewPatterns() {
      try {
        var svg = document.querySelector('#welcome-map-preview svg');
        if (!svg) return;
        var defs = svg.querySelector('defs') || svg.insertBefore(document.createElementNS('http://www.w3.org/2000/svg', 'defs'), svg.firstChild);
        var patterns = [
          { id: 'tree-pattern-wel', img: '/svg/mataatlantica.png', size: 100, icons: [[10,10,40],[60,50,30]] },
          { id: 'pampa-pattern-wel', img: '/svg/pampa.png', size: 80, icons: [[10,10,35],[45,40,25]] },
          { id: 'cerrado-pattern-wel', img: '/svg/cerrado.png', size: 90, icons: [[10,10,40],[55,45,30]] }
        ];
        patterns.forEach(function (p) {
          try {
            if (svg.querySelector('#' + p.id)) return;
            var pat = document.createElementNS('http://www.w3.org/2000/svg', 'pattern');
            pat.setAttribute('id', p.id);
            pat.setAttribute('patternUnits', 'userSpaceOnUse');
            pat.setAttribute('width', p.size);
            pat.setAttribute('height', p.size);
            p.icons.forEach(function (icon) {
              var img = document.createElementNS('http://www.w3.org/2000/svg', 'image');
              img.setAttributeNS('http://www.w3.org/1999/xlink', 'href', p.img);
              img.setAttribute('x', icon[0]);
              img.setAttribute('y', icon[1]);
              img.setAttribute('width', icon[2]);
              img.setAttribute('height', icon[2]);
              img.setAttribute('opacity', '0.7');
              pat.appendChild(img);
            });
            defs.appendChild(pat);
          } catch (e) {}
        });
      } catch (e) {}
    }
    function loadPreviewBase() {
      if (!previewMap || typeof fetch === 'undefined') return;
      var svgRenderer = null;
      try { svgRenderer = L.svg({ padding: 0 }); } catch (e) { return; }
      var pampas = L.geoJson(null, { renderer: svgRenderer, interactive: false, style: { color: 'transparent', fillColor: '#3b7ba5', fillOpacity: 0.3 } }).addTo(previewMap);
      var pampasPat = L.geoJson(null, { renderer: svgRenderer, interactive: false, style: { color: 'transparent', fillColor: 'url(#pampa-pattern-wel)', fillOpacity: 0.6 } }).addTo(previewMap);
      var cerrado = L.geoJson(null, { renderer: svgRenderer, interactive: false, style: { color: 'transparent', fillColor: '#E6C140', fillOpacity: 0.4 } }).addTo(previewMap);
      var cerradoPat = L.geoJson(null, { renderer: svgRenderer, interactive: false, style: { color: 'transparent', fillColor: 'url(#cerrado-pattern-wel)', fillOpacity: 0.6 } }).addTo(previewMap);
      var atlantic = L.geoJson(null, { renderer: svgRenderer, interactive: false, style: { color: 'transparent', fillColor: '#287f5e', fillOpacity: 0.1 } }).addTo(previewMap);
      var atlanticPat = L.geoJson(null, { renderer: svgRenderer, interactive: false, style: { color: 'transparent', fillColor: 'url(#tree-pattern-wel)', fillOpacity: 0.6 } }).addTo(previewMap);
      var localMask = [[[-90, -180], [-90, 180], [90, 180], [90, -180], [-90, -180]]];
      var mask = null;
      try {
        mask = L.polygon(localMask, { interactive: false, color: 'transparent', fillColor: '#000000', fillOpacity: 0.6, fillRule: 'evenodd' }).addTo(previewMap);
      } catch (e) {}
      function pushMaskHoles(d) {
        try {
          (d.features || []).forEach(function (f) {
            if (!f.geometry) return;
            var type = f.geometry.type;
            var coords = f.geometry.coordinates;
            if (type === 'Polygon') {
              coords.forEach(function (ring) { localMask.push(ring.map(function (c) { return [c[1], c[0]]; })); });
            } else if (type === 'MultiPolygon') {
              coords.forEach(function (poly) { poly.forEach(function (ring) { localMask.push(ring.map(function (c) { return [c[1], c[0]]; })); }); });
            }
          });
          if (mask) mask.setLatLngs(localMask);
        } catch (e) {}
      }
      function getJSON(url) {
        return fetch(url, { headers: { 'Accept': 'application/json' } }).then(function (res) { return res.ok ? res.json() : null; }).catch(function () { return null; });
      }
      Promise.all([
        getJSON('/data/ATLANTIC_FOREST_LAW.json'),
        getJSON('/data/br_pr.json'),
        getJSON('/data/br_sc.json'),
        getJSON('/data/br_rs.json')
      ]).then(function (all) {
        if (!previewMap) return;
        var forestData = all[0], prData = all[1], scData = all[2], rsData = all[3];
        if (forestData && window.turf) {
          try {
            var simplifiedForest = turf.simplify(forestData, { tolerance: 0.005, highPrecision: false });
            atlantic.addData(simplifiedForest);
            atlanticPat.addData(simplifiedForest);
            var merged = simplifiedForest.features[0];
            for (var i = 1; i < simplifiedForest.features.length; i++) {
              try {
                var union = turf.union(merged, simplifiedForest.features[i]);
                if (union) merged = union;
              } catch (e) {}
            }
            var cleanForest = turf.simplify(turf.buffer(merged, 0), { tolerance: 0.003 });
            if (rsData && rsData.features && cleanForest) {
              var pampaDiff = turf.difference(turf.simplify(turf.buffer(rsData.features[0], 0), { tolerance: 0.003 }), cleanForest);
              if (pampaDiff) { pampas.addData(pampaDiff); pampasPat.addData(pampaDiff); }
            }
            if (prData && prData.features && cleanForest) {
              var cerradoDiff = turf.difference(turf.simplify(turf.buffer(prData.features[0], 0), { tolerance: 0.003 }), cleanForest);
              if (cerradoDiff) { cerrado.addData(cerradoDiff); cerradoPat.addData(cerradoDiff); }
            }
          } catch (e) {}
        }
        if (prData) { try { L.geoJson(prData, { interactive: false, style: { color: '#1E7552', weight: 2, fillOpacity: 0 } }).addTo(previewMap); } catch (e) {} pushMaskHoles(prData); }
        if (scData) { try { L.geoJson(scData, { interactive: false, style: { color: '#FF0000', weight: 2, fillOpacity: 0 } }).addTo(previewMap); } catch (e) {} pushMaskHoles(scData); }
        if (rsData) { try { L.geoJson(rsData, { interactive: false, style: { color: '#FFFF00', weight: 2, fillOpacity: 0 } }).addTo(previewMap); } catch (e) {} pushMaskHoles(rsData); }
        injectPreviewPatterns();
      });
      // Zonas de preservação (mesmas cores do mapa principal).
      getJSON('/api/v1/zonas-preservacao/').then(function (res) {
        if (!res || !previewMap) return;
        var fc = (res && res.data) || res;
        (fc.features || []).forEach(function (f) {
          try {
            var g = f.geometry;
            if (!g || !g.coordinates) return;
            var p = f.properties || {};
            var color = (/^[#][0-9a-fA-F]{6}$/.test(p.color || '')) ? p.color : '#287f5e';
            var polys = [];
            if (g.type === 'MultiPolygon') polys = g.coordinates;
            else if (g.type === 'Polygon') polys = [g.coordinates];
            polys.forEach(function (polyCoords) {
              var latlngs = polyCoords.map(function (ring) {
                return ring.map(function (c) { return [c[1], c[0]]; });
              });
              L.polygon(latlngs, { color: color, fillColor: color, fillOpacity: 0.25, weight: 2, interactive: false }).addTo(previewMap);
            });
          } catch (e) {}
        });
      });
      // Animais (limitado p/ leveza) e ONGs.
      getJSON('/api/markers').then(function (data) {
        if (!data || !data.features || !previewMap) return;
        data.features.slice(0, 250).forEach(function (feature) {
          try {
            var coords = feature.geometry && feature.geometry.coordinates;
            if (!coords || coords.length < 2) return;
            var p = feature.properties || {};
            var borderColor = previewStatusColor(p.nivel_sigla);
            var iconSrc = p.icone || '/assets/img/logotipo.png';
            var iconFb = (iconSrc || '').indexOf('logotipo.png') !== -1;
            L.marker([coords[1], coords[0]], {
              interactive: false,
              icon: L.divIcon({
                className: 'custom-animal-marker',
                html: '<div class="marker-pin" style="border-color: ' + borderColor + ';"><div class="marker-avatar"><img src="' + iconSrc + '" alt="' + (iconFb ? 'Imagem livre não encontrada' : '') + '">' + (iconFb ? '<span class="avatar-fallback-tag" title="Imagem livre não encontrada">Imagem livre não encontrada</span>' : '') + '</div></div>',
                iconSize: [36, 36],
                iconAnchor: [18, 18]
              })
            }).addTo(previewMap);
          } catch (e) {}
        });
      });
      getJSON('/api/v1/ongs/').then(function (res) {
        if (!res || !previewMap) return;
        var fc = (res && res.data) || res;
        (fc.features || []).forEach(function (f) {
          try {
            var coords = f.geometry && f.geometry.coordinates;
            if (!coords || coords.length < 2) return;
            L.marker([coords[1], coords[0]], {
              interactive: false,
              icon: L.divIcon({
                className: 'custom-animal-marker',
                html: '<div class="marker-pin" style="border-color: #3498db; background-color: #1e3d59;"><i class="fa-solid fa-hand-holding-heart text-info" style="font-size: 18px;"></i></div>',
                iconSize: [36, 36],
                iconAnchor: [18, 18]
              })
            }).addTo(previewMap);
          } catch (e) {}
        });
      });
    }

    function stopTourForGood() {
      tourStoppedByUser = true;
      stopTour();
    }

    // Tour entre capitais do Sul; pausa sozinho fora da tela / com a aba
    // oculta / em reduced-motion / após o usuário assumir o controle.
    function startTour() {
      stopTour();
      if (tourStoppedByUser) return;
      var reduceMotion = false;
      try { reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      if (reduceMotion || !previewMap) return;
      tourTimer = setInterval(function () {
        if (!isOpen() || !previewMap) return;
        if (document.hidden) return;
        tourIdx = (tourIdx + 1) % PREVIEW_TOUR.length;
        try { previewMap.flyTo([PREVIEW_TOUR[tourIdx].lat, PREVIEW_TOUR[tourIdx].lng], 7, { duration: 2.5 }); } catch (e) {}
      }, PREVIEW_TOUR_MS);
    }

    function stopTour() {
      if (tourTimer) { clearInterval(tourTimer); tourTimer = null; }
    }

    // --- Abertura: ignora o cookie quando forçada (botão "Sobre") ---
    function openWelcome(opts) {
      opts = opts || {};
      if (isOpen()) return;
      lastFocused = document.activeElement;
      // Reflete a preferência salva no checkbox ao abrir.
      try { checkbox.checked = welcomeGetCookie(STORAGE_KEY) === 'true'; } catch (e) {}
      overlay.classList.remove('d-none');
      // Reflow para a transição fade+slide funcionar após sair do display:none.
      void overlay.offsetWidth;
      overlay.classList.add('is-open');
      overlay.classList.remove('is-closing');
      overlay.setAttribute('aria-hidden', 'false');
      // Trava o scroll da página de fundo enquanto o modal está aberto.
      document.documentElement.style.overflow = 'hidden';
      scrollEl.scrollTop = 0;
      updateScrollHint();
      // Preview é criado uma vez, na primeira abertura (com o layout visível).
      initPreview();
      try { if (previewMap) previewMap.invalidateSize(); } catch (e) {}
      // Reaberturas (botão Sobre): layout pode ainda estar animando.
      setTimeout(function () { try { if (isOpen() && previewMap) previewMap.invalidateSize(); } catch (e) {} }, 500);
      // Cinto e suspensórios: quando a transição de abertura terminar,
      // mede de novo (cobre qualquer corrida de layout restante).
      try {
        if (!overlay.dataset.welcomeTransitionHook) {
          overlay.dataset.welcomeTransitionHook = '1';
          overlay.addEventListener('transitionend', function () {
            try { if (isOpen() && previewMap) previewMap.invalidateSize(); } catch (e) {}
          });
        }
      } catch (e) {}
      // Foco inicial dentro do modal.
      setTimeout(function () { (closeX || scrollEl).focus(); }, 60);
    }

    // --- Fechamento com animação de saída + persistência da preferência ---
    function closeWelcome() {
      if (!isOpen()) return;
      try {
        if (checkbox.checked) welcomeSetSessionCookie(STORAGE_KEY, 'true');
        else welcomeSetSessionCookie(STORAGE_KEY, null);
      } catch (e) {}
      overlay.classList.remove('is-open');
      overlay.classList.add('is-closing');
      setTimeout(function () {
        overlay.classList.add('d-none');
        overlay.classList.remove('is-closing');
        overlay.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
        // Devolve o foco para quem abriu (botão "Sobre" ou body).
        if (lastFocused && document.contains(lastFocused)) lastFocused.focus();
      }, ANIM_MS);
    }

    // Mostra/esconde o fade + seta conforme a posição do scroll.
    function updateScrollHint() {
      if (!scrollEl) return;
      var rest = scrollEl.scrollHeight - scrollEl.scrollTop - scrollEl.clientHeight;
      var hasMore = rest > 24;
      hint.classList.toggle('is-hidden', !hasMore);
      fade.classList.toggle('is-hidden', !hasMore);
    }

    function bind() {
      overlay = document.querySelector('[data-welcome-overlay]');
      if (!overlay) return;
      scrollEl = $('welcome-scroll');
      closeX = $('welcome-close-x');
      closeBtn = $('welcome-close-btn');
      checkbox = $('welcome-hide-checkbox');
      hint = $('welcome-scroll-hint');
      fade = $('welcome-fade');

      closeX.addEventListener('click', closeWelcome);
      closeBtn.addEventListener('click', closeWelcome);

      // Tecla Esc fecha; Tab fica preso dentro do modal (focus trap).
      document.addEventListener('keydown', function (e) {
        if (!isOpen()) return;
        if (e.key === 'Escape') { e.preventDefault(); closeWelcome(); return; }
        if (e.key !== 'Tab') return;
        var items = focusables();
        if (items.length === 0) { e.preventDefault(); return; }
        var first = items[0];
        var last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });

      // Seta de "ver mais" rola o conteúdo suavemente.
      hint.addEventListener('click', function () {
        scrollEl.scrollBy({ top: Math.round(scrollEl.clientHeight * 0.7), behavior: 'smooth' });
      });
      scrollEl.addEventListener('scroll', updateScrollHint, { passive: true });
      window.addEventListener('resize', function () {
        updateScrollHint();
        try { if (isOpen() && previewMap) previewMap.invalidateSize(); } catch (e) {}
      });

      // Botão "Sobre" do menu lateral reabre SEMPRE (ignora preferência salva).
      // Inclui também qualquer gatilho futuro com [data-open-welcome].
      function forceOpen(e) {
        if (e) e.preventDefault();
        openWelcome({ force: true });
      }
      var aboutBtn = document.getElementById('about-btn');
      if (aboutBtn) aboutBtn.addEventListener('click', forceOpen);
      document.querySelectorAll('[data-open-welcome]').forEach(function (el) {
        el.addEventListener('click', forceOpen);
      });

      // API global opcional para reabrir via console ou outro script.
      window.openWelcomeModal = function () { openWelcome({ force: true }); };
      window.closeWelcomeModal = closeWelcome;

      // Abertura automática: só pula se o usuário marcou "não mostrar novamente".
      var hidden = false;
      try { hidden = welcomeGetCookie(STORAGE_KEY) === 'true'; } catch (e) {}
      if (!hidden) setTimeout(function () { openWelcome(); }, 350);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
    else bind();
  })();
