extends layouts/main

block content
  .species-modal-fullscreen(style="position: relative; left: 0; top: 0; width: 100%; height: 100%;")
    .species-split-layout
      //- PAINEL ESQUERDO: FORMULÁRIO CADASTRAR ANIMAIS (RESTRITO A ADMINISTRADORES)
      #admin-species-form-panel.species-form-panel.d-none
        .d-flex.align-items-center.justify-content-between.mb-3
          h2.species-title.mb-0 CADASTRAR ANIMAIS
          button#btn-open-salve-modal.btn.btn-sm.btn-outline-warning.rounded-pill.px-3.fw-bold(type="button", data-bs-toggle="modal", data-bs-target="#modalImportSalve", title="Importar planilha de espécies do SALVE (ICMBio)")
            i.fa-solid.fa-file-csv.me-1
            span Importar SALVE

        form#form-species-create(action="/api/v1/animais/", method="POST", enctype="multipart/form-data")
          input#animal-id-hidden(type="hidden", name="animal_id")
          input#coordenadas-json-hidden(type="hidden", name="coordenadas_json")
          input#area-polygon-json-hidden(type="hidden", name="area_polygon_json")
          input.coord-lat(type="hidden", name="lat")
          input.coord-lng(type="hidden", name="lng")

          //- Seção de Uploads (Imagens e Ícone Recortáveis com Drag e Wheel Zoom)
          .row.g-3.mb-4
            .col-md-7
              label.species-form-label.fw-bold.mb-2 Galeria de Imagens da Espécie (Arraste / Zoom no Card)
              input#input-file-image.d-none(type="file", name="animal_imagem", accept="image/*", multiple)
              
              .upload-gallery-container.p-3.rounded-4.border(style="background: #191820; border-color: #333240 !important;")
                .d-flex.flex-row.align-items-center.gap-3.overflow-x-auto.p-1#image-preview-scroll(style="min-height: 145px; scrollbar-width: thin;")
                  #image-preview-list.d-flex.flex-row.gap-3.align-items-center
                    //- Cards dinâmicos maiores (130x130) com drag + wheel zoom e botão X
                  
                  button#btn-add-images.btn.d-flex.flex-column.align-items-center.justify-content-center.rounded-3.text-decoration-none(type="button", style="width: 130px; height: 130px; min-width: 130px; border: 2px dashed #1a5fb4; background: rgba(26, 95, 180, 0.12); color: #539bf5; transition: all 0.2s ease;")
                    i.fa-solid.fa-plus.fs-3.mb-1
                    span.fw-bold(style="font-size: 11px;") Adicionar Foto

                span#image-preview-placeholder.text-secondary.small.d-block.text-center.mt-2 Nenhuma foto selecionada. Clique no + para adicionar.

            .col-md-5
              label.species-form-label.fw-bold.mb-2 Ícone do Marcador
              input#input-file-icon.d-none(type="file", name="animal_icone", accept="image/*")
              input#input-icon-base64(type="hidden", name="icone_base64")

              .d-flex.flex-column.align-items-center.justify-content-center.p-3.rounded-4.border(style="background: #191820; border-color: #333240 !important; min-height: 145px;")
                #icon-circle-trigger.rounded-circle.overflow-hidden.position-relative.border.shadow-sm(style="width: 105px; height: 105px; border-color: #1a5fb4 !important; background: #121118; display: flex; align-items: center; justify-content: center; cursor: pointer;", title="Arraste para mover ou use a roda do mouse para zoom")
                  #icon-placeholder-content.text-center.text-secondary
                    i.fa-solid.fa-paw.fs-3.mb-1.d-block(style="color: #539bf5;")
                    span(style="font-size: 10px;") Sem Ícone
                  img#icon-preview-img.position-absolute.d-none(src="", alt="Preview Ícone", style="cursor: move; user-select: none; touch-action: none;")
                
                button#btn-choose-icon.btn.btn-sm.btn-outline-primary.rounded-pill.mt-2.px-3(type="button")
                  i.fa-solid.fa-folder-open.me-1
                  span Escolher Ícone

                span.text-muted.mt-1(style="font-size: 10px;") Arraste p/ mover • Roda do mouse p/ zoom

          //- Linha 1: Nome Comum e Nome Científico
          .row.g-3.mb-3
            .col-md-6
              label.species-form-label(for="nome_comum") Nome Comum
              input#nome_comum.form-control.colored-pill-input-bronze(type="text", name="nome_comum", placeholder="Humano", required)
            .col-md-6
              label.species-form-label(for="nome_cientifico") Nome Científico
              input#nome_cientifico.form-control.colored-pill-input-crimson(type="text", name="nome_cientifico", placeholder="Homo sapiens", required)

          //- Linha 2: Classe e Família
          .row.g-3.mb-3
            .col-md-6
              label.species-form-label(for="classe") Classe
              select#classe.form-select.colored-pill-input-green(name="classe")
                option(value="Mammalia", selected) Mamíferos
                option(value="Aves") Aves
                option(value="Reptilia") Répteis
                option(value="Amphibia") Anfíbios
                option(value="Chondrichthyes") Peixes Cartilaginosos
                option(value="Osteichthyes") Peixes Ósseos
            .col-md-6
              label.species-form-label(for="familia") Família
              input#familia.form-control.colored-pill-input-blue(type="text", name="familia", placeholder="Hominidae")

          //- Linha 3: Nível de Extinção (Colorido) e Biomas (Chips Coloridos)
          .row.g-3.mb-3
            .col-md-6
              label.species-form-label(for="nivel_extincao_id") Nível de extinção
              select#nivel_extincao_id.form-select.select-nivel-extincao.dark-pill-select(name="nivel_extincao_id", required)
                option(value="") NÍVEL DE EXTINÇÃO
                option(value="1", data-sigla="ex", style="background-color: #403E4C; color: #FFF; font-weight: bold; padding: 8px;") Extinta
                option(value="2", data-sigla="ew", style="background-color: #831F34; color: #FFF; font-weight: bold; padding: 8px;") Extinta na Natureza
                option(value="9", data-sigla="re", style="background-color: #B0214F; color: #FFF; font-weight: bold; padding: 8px;") Regionalmente Extinta
                option(value="3", data-sigla="cr", style="background-color: #FF4068; color: #FFF; font-weight: bold; padding: 8px;") Criticamente em Perigo
                option(value="4", data-sigla="en", style="background-color: #FF6426; color: #FFF; font-weight: bold; padding: 8px;") Em Perigo
                option(value="5", data-sigla="vu", style="background-color: #FFA63A; color: #111; font-weight: bold; padding: 8px;") Vulnerável
                option(value="6", data-sigla="nt", style="background-color: #217757; color: #FFF; font-weight: bold; padding: 8px;") Quase Ameaçada
                option(value="7", data-sigla="lc", style="background-color: #1A5FB4; color: #FFF; font-weight: bold; padding: 8px;") Pouco Preocupante
                option(value="8", data-sigla="dd", style="background-color: #555555; color: #FFF; font-weight: bold; padding: 8px;") Dados Insuficientes
            .col-md-6
              label.species-form-label Biomas
              #biomes-tag-selector.biomes-tag-container
                .biome-chip.biome-chip-mata-atlantica(data-id="1", data-selected="true")
                  span Mata Atlântica
                  i.fa-solid.fa-check.chip-icon
                .biome-chip.biome-chip-pampa(data-id="2", data-selected="true")
                  span Pampa
                  i.fa-solid.fa-check.chip-icon
                .biome-chip.biome-chip-cerrado(data-id="3", data-selected="false")
                  span Cerrado
                  i.fa-solid.fa-plus.chip-icon
                select#bioma-selector.d-none(name="biomas_ids", multiple)
                  option(value="1", selected) Mata Atlântica
                  option(value="2", selected) Pampa
                  option(value="3") Cerrado

          //- Linha 4: Peso, Altura e Dieta
          .row.g-3.mb-3
            .col-md-4
              label.species-form-label(for="peso") Peso (g)
              .custom-stepper-wrapper
                input#peso.form-control.colored-pill-input-green(type="number", step="1", min="0", name="peso", placeholder="Ex: 600")
            .col-md-4
              label.species-form-label(for="altura") Altura / Comp. (cm)
              .custom-stepper-wrapper
                input#altura.form-control.colored-pill-input-blue(type="number", step="0.1", min="0", name="altura", placeholder="Ex: 26")
            .col-md-4
              label.species-form-label(for="dieta") Dieta
              input#dieta.form-control.colored-pill-input-crimson(type="text", name="dieta", placeholder="Ex: Onívoro, Insetos")

          //- Linha 5: Descrição / Curiosidade (campo único)
          .row.g-3.mb-4
            .col-12
              label.species-form-label(for="habitos") Descrição / Curiosidade
              textarea#habitos.form-control.colored-pill-input-bronze(name="habitos", rows="2", placeholder="Descrição, curiosidades e notas de conservação...")

          //- Botões de Ação
          .d-flex.gap-3.mt-auto
            button#btn-save-species.btn.btn-warning.fw-bold.rounded-pill.px-4.py-2(type="submit", style="background-color: #9C5B1C; border: none; color: #FFF;")
              i.fa-solid.fa-check.me-2
              | Salvar Espécie
            button#btn-reset-form.btn.btn-outline-secondary.rounded-pill.px-4.py-2(type="button")
              i.fa-solid.fa-rotate-left.me-2
              | Limpar

      //- PAINEL DIREITO: MAPA / ANIMAIS CADASTRADOS
      #species-display-panel.species-display-panel
        //- Barra Superior com Alternância
        .view-toggle-bar
          .view-toggle-btns
            button#toggle-btn-list.toggle-btn.active(type="button")
              i.fa-solid.fa-list
              | Animais Cadastrados
            button#toggle-btn-map.toggle-btn(type="button")
              i.fa-solid.fa-map-location-dot
              | Mapa da Localização

        //- VISÃO 1: LISTA DE ANIMAIS CADASTRADOS
        #panel-view-list.h-100.d-flex.flex-column
          //- Barra de Ferramentas e Filtros da Fauna
          .species-toolbar-container.mb-3
            //- Linha 1: Pesquisa de Texto e Botões de Ação
            .species-search-row.d-flex.align-items-center.gap-2.mb-2.flex-wrap
              .search-box-wrapper.flex-grow-1.mb-0.position-relative
                i.fa-solid.fa-magnifying-glass.search-icon-left
                input#animalSearch.form-control.right-panel-search(type="text", placeholder="Pesquisar por nome comum, científico, família...", autocomplete="off")
                button#btn-clear-search.btn-clear-search.d-none(type="button", title="Limpar busca")
                  i.fa-solid.fa-xmark

              button#btn-filter-favs.btn.species-filter-btn-fav(type="button", title="Exibir apenas animais favoritados")
                i.fa-solid.fa-star.me-1
                span Apenas Favoritos
                span#favs-pill-counter.badge.badge-pill-fav.ms-1 0

              button#btn-reset-filters.btn.btn-outline-secondary.species-btn-reset.d-none(type="button", title="Resetar todos os filtros")
                i.fa-solid.fa-rotate-left.me-1
                span Limpar Filtros

            //- Linha 2: Filtros por Bioma, Nível de Ameaça, Classe e Ordenação
            .species-filters-grid.d-flex.align-items-center.gap-2.flex-wrap
              //- Filtro de Bioma
              .filter-pill-select-wrapper
                span.filter-pill-label
                  i.fa-solid.fa-leaf.me-1
                  | Bioma:
                select#filter-biome.form-select.species-select-filter
                  option(value="all") Todos os Biomas
                  option(value="1") Mata Atlântica
                  option(value="2") Pampa
                  option(value="3") Cerrado
                  option(value="4") Oceano Atlântico

              //- Filtro de Nível de Extinção
              .filter-pill-select-wrapper
                span.filter-pill-label
                  i.fa-solid.fa-triangle-exclamation.me-1
                  | Extinção:
                select#filter-extinction.form-select.species-select-filter
                  option(value="all") Todos os Níveis
                  option(value="threatened") Somente Ameaçadas (CR, EN, VU)
                  option(value="cr") CR • Criticamente em Perigo
                  option(value="en") EN • Em Perigo
                  option(value="vu") VU • Vulnerável
                  option(value="nt") NT • Quase Ameaçada
                  option(value="lc") LC • Pouco Preocupante
                  option(value="dd") DD • Dados Insuficientes
                  option(value="re") RE • Regionalmente Extinta
                  option(value="ew") EW • Extinta na Natureza
                  option(value="ex") EX • Extinta

              //- Filtro de Classe Taxonômica
              .filter-pill-select-wrapper
                span.filter-pill-label
                  i.fa-solid.fa-paw.me-1
                  | Classe:
                select#filter-class.form-select.species-select-filter
                  option(value="all") Todas as Classes
                  option(value="Mammalia") Mamíferos
                  option(value="Aves") Aves
                  option(value="Reptilia") Répteis
                  option(value="Amphibia") Anfíbios
                  option(value="Peixes") Peixes

              //- Ordenação
              .filter-pill-select-wrapper
                span.filter-pill-label
                  i.fa-solid.fa-arrow-down-a-z.me-1
                  | Ordem:
                select#filter-sort.form-select.species-select-filter
                  option(value="name_asc") Nome (A → Z)
                  option(value="name_desc") Nome (Z → A)
                  option(value="threat_desc") Mais Ameaçados
                  option(value="threat_asc") Menos Ameaçados

            //- Linha 3: Resumo dos Resultados e Tags Ativas
            .species-filter-status-bar.d-flex.align-items-center.justify-content-between.mt-2.pt-2
              .d-flex.align-items-center.gap-2.flex-wrap
                span#species-results-summary.species-results-summary
                  i.fa-solid.fa-sliders.me-1
                  span Exibindo espécies
                #species-active-tags.d-flex.align-items-center.gap-1.flex-wrap

          //- Área de Rolagem dos Cards com Divisão Clara
          .species-cards-scroll-area
            //- SEÇÃO 1: FAVORITOS
            #fav-section.species-section-container.species-fav-deck.d-none
              .species-section-banner.fav-banner
                .section-banner-title-area
                  .section-banner-icon.fav-icon-box
                    i.fa-solid.fa-star
                  .section-banner-headings
                    .d-flex.align-items-center.gap-2
                      h3.section-banner-heading Espécies Favoritadas
                      span#fav-count-pill.badge.badge-fav-counter 0 salvas
                    p.section-banner-description Animais marcados como favoritos para acompanhamento rápido
                .section-banner-tools
                  span.text-muted.small.d-none.d-md-inline-block Clique na estrela do card para gerenciar favoritos

              .species-fav-grid-wrapper
                #favGrid.species-cards-grid

            //- SEPARADOR VISUAL ELEGANTE (Aparece quando há favoritos E outras espécies)
            #species-sections-divider.species-sections-divider.d-none
              .divider-line
              .divider-badge
                i.fa-solid.fa-layer-group.me-2
                span Demais Espécies Cadastradas
              .divider-line

            //- SEÇÃO 2: DEMAIS / TODAS AS ESPÉCIES
            #regular-section.species-section-container.species-regular-deck
              .species-section-banner.regular-banner
                .section-banner-title-area
                  .section-banner-icon.regular-icon-box
                    i.fa-solid.fa-paw
                  .section-banner-headings
                    .d-flex.align-items-center.gap-2
                      h3#regular-section-title.section-banner-heading Todas as Espécies
                      span#regular-count-pill.badge.badge-regular-counter 0 espécies
                    p#regular-section-subtitle.section-banner-description Catálogo completo de espécies da fauna do Sul do Brasil

              #animalCardsGrid.species-cards-grid

            //- ESTADO VAZIO (Nenhum resultado para os filtros)
            #species-empty-state.species-empty-state-box.d-none
              .empty-state-illustration
                i.fa-solid.fa-magnifying-glass.empty-search-icon
                i.fa-solid.fa-paw.empty-paw-icon
              h4.empty-state-title Nenhuma espécie encontrada
              p.empty-state-text Não encontramos nenhum animal correspondente aos filtros e termos pesquisados.
              button#btn-empty-reset.btn.btn-warning.rounded-pill.px-4.py-2.fw-bold(type="button")
                i.fa-solid.fa-rotate-left.me-2
                | Redefinir Todos os Filtros

        //- VISÃO 2: MAPA DA LOCALIZAÇÃO
        #panel-view-map.h-100.d-flex.flex-column.d-none
          .map-location-controls.d-flex.align-items-center.gap-2.mb-2.p-2.rounded-3.flex-wrap(style="background-color: #2B2A33;")
            button#btn-draw-polygon-mode.btn.btn-info.btn-sm.rounded-pill.fw-bold.text-dark(type="button")
              i.fa-solid.fa-draw-polygon.me-1
              | Desenhar Área
            button#btn-new-polygon-area.btn.btn-outline-warning.btn-sm.rounded-pill.fw-bold(type="button", title="Criar outra área separada")
              i.fa-solid.fa-plus.me-1
              | Nova Área
            button#btn-undo-polygon.btn.btn-dark.btn-sm.rounded-circle(type="button", title="Desfazer (Ctrl+Z)", style="width: 32px; height: 32px; padding: 0;")
              i.fa-solid.fa-rotate-left
            button#btn-redo-polygon.btn.btn-dark.btn-sm.rounded-circle(type="button", title="Refazer (Ctrl+Y)", style="width: 32px; height: 32px; padding: 0;")
              i.fa-solid.fa-rotate-right
            .d-flex.align-items-center.gap-1.ms-1(title="Escolher Cor da Área")
              label.small.text-light.mb-0 Cor:
              input#polygon-color-picker.form-control.form-control-color.p-0.border-0.rounded-circle(type="color", value="#FFAA44", style="width: 28px; height: 28px; cursor: pointer;")
            button#btn-clear-polygon.btn.btn-outline-danger.btn-sm.rounded-pill.ms-1(type="button")
              i.fa-solid.fa-eraser.me-1
              | Limpar
            .d-flex.align-items-center.gap-1.ms-1(title="Preencher a área de ocorrência com o bioma inteiro, sem desenhar manualmente")
              label.small.text-light.mb-0 Bioma:
              select#biome-area-selector.form-select.form-select-sm(style="background: #191820; color: #FFF; border-color: #444; max-width: 150px;")
                option(value="mata_atlantica") Mata Atlântica
                option(value="pampa") Pampa
                option(value="cerrado") Cerrado
              button#btn-use-biome-area.btn.btn-success.btn-sm.rounded-pill.fw-bold(type="button", title="Carrega o polígono do bioma como área de ocorrência (editável depois)")
                i.fa-solid.fa-leaf.me-1
                | Usar bioma
            span#polygon-status-badge.badge.bg-dark.text-warning.border.border-warning.ms-auto Área: Todo o Mapa
          .flex-grow-1(style="min-height: 0;")
            #right-panel-map-container

  //- Modal de Detalhes da Espécie (Card Completo)
  #animalModal.modal.fade(tabindex="-1", aria-hidden="true")
    .modal-dialog.modal-xl.modal-dialog-centered
      .modal-content.border-0.shadow-lg(style="background-color: #23222B;")
        .modal-header.border-bottom.border-secondary
          h5#modalAnimalName.modal-title.fw-bold
          button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
        #modalBody.modal-body.p-0
        .modal-footer.border-top.border-secondary.d-flex.justify-content-between
          #modalAdminBtns.d-flex.gap-2
          button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Fechar

  //- Modal de Importação de Planilha SALVE (ICMBio)
  #modalImportSalve.modal.fade(tabindex="-1", aria-hidden="true")
    .modal-dialog.modal-lg.modal-dialog-centered
      .modal-content.border-0.shadow-lg(style="background-color: #23222B; color: #E0E0E0;")
        .modal-header.border-bottom.border-secondary
          .d-flex.align-items-center.gap-2
            i.fa-solid.fa-cloud-arrow-up.fs-4.text-warning
            h5.modal-title.fw-bold Importar Espécies do SALVE (ICMBio)
          button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
        .modal-body.p-4
          p.text-light.small.mb-3
            | Selecione ou arraste a 
            strong Planilha de Espécies (.csv)
            |  exportada do site oficial do 
            strong SALVE (ICMBio)
            |. As espécies do Sul do Brasil terão suas categorias de extinção, biomas, polígonos de ocorrência (Pampa/Mata Atlântica) e fotos atribuídos automaticamente.

          //- Área de Drag and Drop
          #salve-drop-zone.border.border-2.border-dashed.rounded-4.p-4.text-center.mb-3(style="background: #191820; border-color: #555465 !important; cursor: pointer; transition: all 0.2s ease;")
            i.fa-solid.fa-file-csv.fs-1.mb-2.d-block(style="color: #FFAA44;")
            h6.fw-bold.mb-1 Arraste o arquivo CSV aqui ou clique para selecionar
            p.text-muted.small.mb-0 Suporta CSV exportado do SALVE (delimitado por ';' ou ',')
            input#salve-file-input.d-none(type="file", accept=".csv,text/csv")

          //- Opções de Importação
          .row.g-3.mb-3
            .col-md-7
              .form-check.form-switch
                input#check-auto-images.form-check-input(type="checkbox", checked)
                label.form-check-label.small.text-light(for="check-auto-images")
                  | Buscar fotos automaticamente na Wikipédia / Wikimedia (acesso aberto)
            .col-md-5
              .d-flex.align-items-center.gap-2
                label.small.text-nowrap.text-light Limite:
                select#select-max-rows.form-select.form-select-sm.dark-pill-select(style="background: #191820; color: #FFF; border-color: #444;")
                  option(value="50") 50 espécies (Rápido)
                  option(value="200") 200 espécies
                  option(value="1000") 1.000 espécies
                  option(value="5000", selected) Todas do arquivo

          //- Prévia do Arquivo Selecionado
          #salve-preview-container.d-none.p-3.rounded-3.mb-3(style="background: #121118; border: 1px solid #333240;")
            .d-flex.align-items-center.justify-content-between.mb-2
              span.badge.bg-success#salve-file-badge Arquivo Carregado
              span#salve-file-info.small.text-muted
            .table-responsive.small(style="max-height: 120px; scrollbar-width: thin;")
              table#salve-preview-table.table.table-dark.table-sm.table-bordered.mb-0(style="font-size: 11px;")
                thead#salve-preview-thead
                tbody#salve-preview-tbody

          //- Barra de Progresso com Porcentagem
          #salve-progress-container.d-none.mb-3
            .d-flex.justify-content-between.align-items-center.mb-1
              span#salve-progress-status.small.text-warning.text-truncate(style="max-width: 80%;")
                i.fa-solid.fa-spinner.fa-spin.me-1
                | Processando espécies e associando biomas...
              span#salve-progress-percent.small.fw-bold.text-warning 0%
            .progress(style="height: 18px; background: #191820; border-radius: 9px; border: 1px solid #333240;")
              #salve-progress-bar.progress-bar.progress-bar-striped.progress-bar-animated.bg-warning.text-dark.fw-bold(role="progressbar", style="width: 0%; font-size: 11px; transition: width 0.2s ease;", aria-valuenow="0", aria-valuemin="0", aria-valuemax="100") 0%

          //- Relatório de Resultado
          #salve-result-container.d-none.p-3.rounded-3.mb-3
            //- Preenchido via JavaScript

        .modal-footer.border-top.border-secondary.d-flex.justify-content-between
          button.btn.btn-outline-secondary.rounded-pill.px-4(type="button", data-bs-dismiss="modal") Fechar
          button#btn-execute-import-salve.btn.btn-warning.fw-bold.rounded-pill.px-4(type="button", disabled)
