extends layouts/main

block head
  style.
    #content {
      flex: 1;
      overflow-y: auto;
      padding: 30px;
      background: linear-gradient(180deg, #2B2A33 0%, #1a1a1f 100%);
    }
    .animal-card {
      background-color: #3b3a43;
      border: 1px solid #1a5fb4;
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      height: 100%;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
    }
    .animal-card::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%; width: 200%; height: 200%;
      background-size: 80px;
      background-repeat: repeat;
      opacity: 0.15;
      transform: rotate(45deg);
      z-index: 0;
      pointer-events: none;
    }
    /* Classes de Textura (aplicadas diretamente no background-image do ::before) */
    .texture-mamiferos::before { background-image: url('/icons/mamiferos.png'); }
    .texture-aves::before { background-image: url('/icons/aves.png'); }
    .texture-anfibios::before { background-image: url('/icons/anfibios.png'); }
    .texture-repteis::before { background-image: url('/icons/repteis.png'); }
    .texture-peixes-cartilaginosos::before { background-image: url('/icons/peixes cartilaginosos.png'); }
    .texture-peixes-osseos::before { background-image: url('/icons/peixes osseos.png'); }
    .texture-default::before { background-image: url('/icons/gralha azul contorno.png'); }
    
    /* Garantir que conteúdo fique acima da textura */
    .animal-card > * { position: relative; z-index: 1; }
    .animal-img-container {
      height: 160px;
      overflow: hidden;
      position: relative;
      background-color: #222;
    }
    .animal-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s;
    }
    .animal-card:hover {
      transform: scale(1.05);
      z-index: 2;
    }
    .animal-card:hover .animal-img {
      transform: scale(1.1);
    }
    .status-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 800;
      color: #fff;
      box-shadow: 0 4px 8px rgba(0,0,0,0.4);
      z-index: 10;
      text-transform: uppercase;
    }
    .card-body {
      padding: 20px;
    }
    .scientific-name {
      font-style: italic;
      color: #FFAA44;
      font-size: 0.85rem;
      margin-bottom: 12px;
      display: block;
    }
    .card-title {
      color: #fff;
      font-weight: 700;
      margin-bottom: 5px;
      font-size: 1.25rem;
    }
    .animal-info {
      font-size: 0.9rem;
      color: #ccc;
      margin-bottom: 15px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .btn-view {
      background-color: #1a5fb4;
      color: #fff;
      border: none;
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      font-weight: 600;
      transition: background 0.2s;
    }
    .btn-view:hover {
      background-color: #2a7ade;
      color: #fff;
    }
    .search-input {
      background-color: rgba(43, 42, 51, 0.8) !important;
      border: 1px solid #1a5fb4 !important;
      color: #fff !important;
      border-radius: 10px !important;
    }
    .search-input:focus {
      box-shadow: 0 0 0 0.25rem rgba(26, 95, 180, 0.25) !important;
      border-color: #FFAA44 !important;
    }
    .input-group-text {
      background-color: #1a5fb4 !important;
      border: 1px solid #1a5fb4 !important;
      color: #fff !important;
      border-radius: 10px 0 0 10px !important;
    }
    h1.fw-bold.mb-1 {
      color: #ffffff;
    }
    p.text-secondary.mb-0 {
      color: #cccccc !important;
    }
    .bg-ex { background-color: #000000; }
    .bg-ew { background-color: #831F34; }
    .bg-cr { background-color: #FF4068; }
    .bg-en { background-color: #ff6426; }
    .bg-vu { background-color: #FFA63A; }
    .bg-nt { background-color: #217757; }
    .bg-lc { background-color: #1a5fb4; }
    .bg-dd { background-color: #555555; }

    /* Animação de Fade para os Cards */
    .fade-image {
      animation: fadeEffect 2s ease-in-out;
    }
    @keyframes fadeEffect {
      0% { opacity: 0.3; }
      100% { opacity: 1; }
    }

    /* Estilos do Carrossel no Modal */
    .modal-img-container {
      width: 100%;
      height: 350px;
      min-height: 400px;
      overflow: hidden;
      position: relative;
      background-color: #222;
    }
    .modal-img-pan {
      width: 150% !important;
      max-width: none !important;
      height: 350px;
      object-fit: cover;
      animation: panModalImage 15s linear infinite alternate;
      position: absolute;
      left: 0;
      top: 0;
      transition: opacity 0.8s ease-in-out;
    }
    @keyframes panModalImage {
      0% { transform: translateX(0); }
      100% { transform: translateX(-33.33%); }
    }
    .carousel-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(26, 95, 180, 0.7);
      color: white;
      border: none;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      cursor: pointer;
      z-index: 1010;
      transition: background 0.3s;
    }
    .carousel-btn:hover { background: rgba(26, 95, 180, 0.9); }
    .carousel-prev { left: 10px; }
    .carousel-next { right: 10px; }

    #vertical-nav .nav {
      display: block;
      padding-left: 0;
      margin-bottom: 0;
      list-style: none;
    }

block content
  #content.container-fluid
    header.mb-5.d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.gap-3
      div
        h1.fw-bold.mb-1 Catálogo de Espécies
        p.text-secondary.mb-0 Explore a biodiversidade ameaçada da Região Sul.
      div(style="min-width: 350px;")
        .input-group
          span.input-group-text
            i.fas.fa-search
          input#animalSearch.form-control.search-input(type="text", placeholder="Pesquisar por nome ou espécie...")

    #animalList.row.g-4
      #loader.col-12.text-center.py-5
        .spinner-border.text-success(style="width: 3rem; height: 3rem;", role="status")
          span.visually-hidden Carregando...
        p.mt-3.text-secondary Carregando espécies...

    #noResults.col-12.text-center.py-5.d-none
      i.fa-solid.fa-magnifying-glass.mb-3(style="font-size: 3rem; color: #444;")
      h3 Nenhum animal encontrado
      p.text-muted Tente ajustar sua pesquisa ou filtros.

  //- Modal de Detalhes
  #animalModal.modal.fade(tabindex="-1", aria-hidden="true")
    .modal-dialog.modal-lg.modal-dialog-centered
      .modal-content.border-0.shadow-lg(style="background-color: #2B2A33;")
        .modal-header.border-bottom.border-secondary
          h5#modalAnimalName.modal-title.fw-bold Nome do Animal
          button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
        #modalBody.modal-body.p-0
          //- Detalhes do animal injetados via JS
        .modal-footer.border-top.border-secondary
          button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Fechar

  //- Logo no canto inferior direito
  img(src="/assets/img/logotipo.png", alt="Logotipo", style="position: fixed; bottom: -20px; right: 20px; width: 300px; z-index: 9999; opacity: 0.8;")

block scripts
  script(src="/assets/js/animais.js")
