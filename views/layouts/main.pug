    meta(name="twitter:description", content= description || "Mapa interativo de espécies ameaçadas de extinção na região Sul do Brasil (PR, SC e RS). Descubra dados ecológicos, biomas, ONGs e áreas de preservação com base no ICMBio e SALVE.")
    meta(name="twitter:image", content= ogImage || "https://tcc-mapa-de-especies.vercel.app/assets/img/logotipo.png")

