extends layouts/main

block content
  #brand-header
    img.brand-logo(src="/assets/img/logotipo.png", alt="Logotipo")
  main#container
    #map
    
    //- Barra de Pesquisa Flutuante com Dropdown Customizado
    #floating-search
      .search-icon-container
        i#searchicon.fa-solid.fa-magnifying-glass
      input#searchbox.form-control(type="text", placeholder="Pesquisar animal ou local...", autocomplete="off")
      #search-results-dropdown.search-dropdown-menu.d-none

    #map-legend.leaflet-bar
      .legend-header(title="Clique e arraste para mover a legenda na tela")
        i.fa-solid.fa-grip-vertical.me-2
        | Legenda
      //- Visibilidade das camadas (usuário comum e admin; o estado persiste
      //- em memória enquanto navega — ver layerVisibility em app.js)
      .legend-section-title Camadas
      .legend-toggle
        label
          input#toggle-layer-animais(type="checkbox", checked)
          |  Ícones de animais
      .legend-toggle
        label
          input#toggle-layer-ongs(type="checkbox", checked)
          |  Marcadores de Instituições
      .legend-toggle
        label
          input#toggle-layer-zonas(type="checkbox", checked)
          |  Zonas de preservação

      hr.legend-divider

      .legend-section-title Biomas
      .legend-items
        .legend-item
          span.legend-color(style="background-color: #287f5e;")
          img.legend-icon(src="/svg/mataatlantica.png")
          span Mata Atlântica
        .legend-item
          span.legend-color(style="background-color: #3b7ba5;")
          img.legend-icon(src="/svg/pampa.png")
          span Pampa
        .legend-item
          span.legend-color(style="background-color: #E6C140;")
          img.legend-icon(src="/svg/cerrado.png")
          span Cerrado
      .legend-toggle
        label
          input#toggle-textures-legend(type="checkbox", checked)
          |  Exibir Texturas

      hr.legend-divider

      .legend-section-title Níveis de Extinção
      .legend-items.extinction-legend-items
        //- Lista completa (8 classificações). Cores idênticas às dos marcadores
        //- (extinctionColorMap em app.js): EX #403E4C e EW #831F34 já existiam
        //- no esquema do site — nenhuma cor nova foi criada.
        .legend-item
          span.extinction-badge(style="background-color: #403E4C;") EX
          span.legend-text Extinta
        .legend-item
          span.extinction-badge(style="background-color: #831F34;") EW
          span.legend-text Extinta na Natureza
        .legend-item
          span.extinction-badge(style="background-color: #FF4068;") CR
          span.legend-text Criticamente em Perigo
        .legend-item
          span.extinction-badge(style="background-color: #FF6426;") EN
          span.legend-text Em Perigo
        .legend-item
          span.extinction-badge(style="background-color: #FFA63A; color: #111;") VU
          span.legend-text Vulnerável
        .legend-item
          span.extinction-badge(style="background-color: #217757;") NT
          span.legend-text Quase Ameaçada
        .legend-item
          span.extinction-badge(style="background-color: #1A5FB4;") LC
          span.legend-text Pouco Preocupante
        .legend-item
          span.extinction-badge(style="background-color: #555555;") DD
          span.legend-text Dados Insuficientes

      hr.legend-divider

      .legend-section-title Tamanho dos Marcadores
      .legend-slider-container
        input#marker-size-slider(type="range", min="0.5", max="2.0", step="0.05", value="1.0", title="Ajuste o tamanho dos marcadores no mapa")
        .legend-slider-labels
          span 50%
          span#marker-size-val 100%
          span 200%

      .legend-toggle#admin-debug-toggle-container.d-none
        hr.legend-divider
        label.text-warning.fw-bold
          input#toggle-debug-areas(type="checkbox")
          i.fa-solid.fa-bug.me-1
          | Exibir Áreas dos Animais (Debug)

    //- Indicador Visual do Modo Admin
    #admin-mode-badge.d-none
      i.fa-solid.fa-user-shield.me-2
      span Modo Administrador Ativo

    //- Menu de Contexto Suspenso (Clique Direito no Modo Admin)
    #admin-context-menu.admin-context-menu.d-none
      .admin-menu-item(data-action="preservacao")
        i.fa-solid.fa-shield-halved.text-success
        span Criar área de preservação
      .admin-menu-item(data-action="animal")
        i.fa-solid.fa-paw.text-warning
        span Criar animal
      .admin-menu-item(data-action="ong")
        i.fa-solid.fa-hand-holding-heart.text-info
        span Criar Instituição

    //- Modal Overlay Split-Screen para Cadastro de Espécies (Criar Animal / Clique Direito)
    #species-admin-modal.species-modal-fullscreen.d-none
      button#close-species-modal-btn.btn-close.btn-close-white(type="button", style="position: absolute; top: 20px; right: 25px; z-index: 3100;")
      .species-split-layout
        //- PAINEL ESQUERDO: FORMULÁRIO CADASTRAR ANIMAIS
        .species-form-panel
          .d-flex.align-items-center.justify-content-between.mb-3
            h2.species-title.mb-0 CADASTRAR ANIMAIS
            button#btn-open-salve-modal.btn.btn-sm.btn-outline-warning.rounded-pill.px-3.fw-bold(type="button", data-bs-toggle="modal", data-bs-target="#modalImportSalve", title="Importar planilha de espécies do SALVE (ICMBio)")
              i.fa-solid.fa-file-csv.me-1
              span Importar SALVE


          form#form-create-animal(action="/api/v1/animais/", method="POST", enctype="multipart/form-data")
            input#animal-edit-id(type="hidden", name="animal_id")
            input#modal-coordenadas-json-hidden(type="hidden", name="coordenadas_json")
            input#modal-area-polygon-json-hidden(type="hidden", name="area_polygon_json")
            input.coord-lat(type="hidden", name="lat", value="-27.59")
            input.coord-lng(type="hidden", name="lng", value="-48.54")

            //- Seção de Uploads (Imagens e Ícone Recortáveis com Drag e Wheel Zoom)
            .row.g-3.mb-4
              .col-md-7
                label.species-form-label.fw-bold.mb-2 Galeria de Imagens da Espécie (Arraste / Zoom no Card)
                input#modal-input-file-image.d-none(type="file", name="animal_imagem", accept="image/*", multiple)
                
                .upload-gallery-container.p-3.rounded-4.border(style="background: #191820; border-color: #333240 !important;")
                  .d-flex.flex-row.align-items-center.gap-3.overflow-x-auto.p-1#modal-image-preview-scroll(style="min-height: 145px; scrollbar-width: thin;")
                    #modal-image-preview-list.d-flex.flex-row.gap-3.align-items-center
                      //- Cards dinâmicos maiores (130x130) com drag + wheel zoom e botão X
                    
                    button#modal-btn-add-images.btn.d-flex.flex-column.align-items-center.justify-content-center.rounded-3.text-decoration-none(type="button", style="width: 130px; height: 130px; min-width: 130px; border: 2px dashed #1a5fb4; background: rgba(26, 95, 180, 0.12); color: #539bf5; transition: all 0.2s ease;")
                      i.fa-solid.fa-plus.fs-3.mb-1
                      span.fw-bold(style="font-size: 11px;") Adicionar Foto

                  span#modal-image-preview-placeholder.text-secondary.small.d-block.text-center.mt-2 Nenhuma foto selecionada. Clique no + para adicionar.

              .col-md-5
                label.species-form-label.fw-bold.mb-2 Ícone do Marcador
                input#modal-input-file-icon.d-none(type="file", name="animal_icone", accept="image/*")
                input#modal-input-icon-base64(type="hidden", name="icone_base64")

                .d-flex.flex-column.align-items-center.justify-content-center.p-3.rounded-4.border(style="background: #191820; border-color: #333240 !important; min-height: 145px;")
                  #modal-icon-circle-trigger.rounded-circle.overflow-hidden.position-relative.border.shadow-sm(style="width: 105px; height: 105px; border-color: #1a5fb4 !important; background: #121118; display: flex; align-items: center; justify-content: center; cursor: pointer;", title="Arraste para mover ou use a roda do mouse para zoom")
                    #modal-icon-placeholder-content.text-center.text-secondary
                      i.fa-solid.fa-paw.fs-3.mb-1.d-block(style="color: #539bf5;")
                      span(style="font-size: 10px;") Sem Ícone
                    img#modal-icon-preview-img.position-absolute.d-none(src="", alt="Preview Ícone", style="cursor: move; user-select: none; touch-action: none;")
                  
                  button#modal-btn-choose-icon.btn.btn-sm.btn-outline-primary.rounded-pill.mt-2.px-3(type="button")
                    i.fa-solid.fa-folder-open.me-1
                    span Escolher Ícone

                  span.text-muted.mt-1(style="font-size: 10px;") Arraste p/ mover • Roda do mouse p/ zoom

            //- Linha 1: Nome Comum e Nome Científico
            .row.g-3.mb-3
              .col-md-6
                label.species-form-label Nome Comum
                input.form-control.colored-pill-input-bronze(type="text", name="nome_comum", placeholder="Humano", required)
              .col-md-6
                label.species-form-label Nome Científico
                input.form-control.colored-pill-input-crimson(type="text", name="nome_cientifico", placeholder="Homo sapiens", required)

            //- Linha 2: Classe e Família
            .row.g-3.mb-3
              .col-md-6
                label.species-form-label Classe
                select.form-select.colored-pill-input-green(name="classe")
                  option(value="Mammalia", selected) Mamíferos
                  option(value="Aves") Aves
                  option(value="Reptilia") Répteis
                  option(value="Amphibia") Anfíbios
                  option(value="Chondrichthyes") Peixes Cartilaginosos
                  option(value="Osteichthyes") Peixes Ósseos
              .col-md-6
                label.species-form-label Família
                input.form-control.colored-pill-input-blue(type="text", name="familia", placeholder="Hominidae")

            //- Linha 3: Nível de Extinção e Biomas
            .row.g-3.mb-3
              .col-md-6
                label.species-form-label Nível de extinção
                select.form-select.select-nivel-extincao.dark-pill-select(name="nivel_extincao_id", required)
                  option(value="") NÍVEL DE EXTINÇÃO
              .col-md-6
                label.species-form-label Biomas
                #modal-biomes-tag-selector.biomes-tag-container
                  .biome-chip.biome-chip-mata-atlantica(data-id="1", data-selected="true")
                    span Mata Atlântica
                    i.fa-solid.fa-check.chip-icon
                  .biome-chip.biome-chip-pampa(data-id="2", data-selected="true")
                    span Pampa
                    i.fa-solid.fa-check.chip-icon
                  .biome-chip.biome-chip-cerrado(data-id="3", data-selected="false")
                    span Cerrado
                    i.fa-solid.fa-plus.chip-icon
                  select.select-biomas.d-none(name="biomas_ids", multiple)
                    option(value="1", selected) Mata Atlântica
                    option(value="2", selected) Pampa
                    option(value="3") Cerrado

            //- Linha 4: Peso, Altura e Dieta
            .row.g-3.mb-3
              .col-md-4
                label.species-form-label Peso (Kg)
                .custom-stepper-wrapper
                  input.form-control.colored-pill-input-green(type="number", step="0.01", name="peso", placeholder="Ex: 0.60")
              .col-md-4
                label.species-form-label Altura / Comp. (m)
                .custom-stepper-wrapper
                  input.form-control.colored-pill-input-blue(type="number", step="0.01", name="altura", placeholder="Ex: 0.26")
              .col-md-4
                label.species-form-label Dieta
                input.form-control.colored-pill-input-crimson(type="text", name="dieta", placeholder="Ex: Onívoro, Insetos")

            //- Linha 5: Descrição / Curiosidade (campo único)
            .row.g-3.mb-4
              .col-12
                label.species-form-label Descrição / Curiosidade
                textarea.form-control.colored-pill-input-bronze(name="habitos", rows="2", placeholder="Descrição, curiosidades e notas de conservação...")

            //- Botões de Ação
            .d-flex.gap-3.mt-auto
              button.btn.btn-warning.fw-bold.rounded-pill.px-4.py-2(type="submit", style="background-color: #9C5B1C; border: none; color: #FFF;")
                i.fa-solid.fa-check.me-2
                | Salvar Espécie
              button.btn.btn-outline-secondary.rounded-pill.px-4.py-2.btn-cancel-modal(type="button")
                i.fa-solid.fa-rotate-left.me-2
                | Limpar

        //- PAINEL DIREITO: MAPA / ANIMAIS CADASTRADOS
        .species-display-panel
          //- Barra Superior com Alternância
          .view-toggle-bar
            .view-toggle-btns
              button#modal-toggle-map.toggle-btn.active(type="button")
                i.fa-solid.fa-map-location-dot
                | Mapa da Localização
              button#modal-toggle-list.toggle-btn(type="button")
                i.fa-solid.fa-list
                | Animais Cadastrados

          //- VISÃO 1: MAPA DA LOCALIZAÇÃO (Padrão para clique direito)
          #modal-panel-map.h-100.d-flex.flex-column
            .map-location-controls.d-flex.align-items-center.gap-2.mb-2.p-2.rounded-3.flex-wrap(style="background-color: #2B2A33;")
              button#modal-btn-draw-polygon-mode.btn.btn-info.btn-sm.rounded-pill.fw-bold.text-dark(type="button")
                i.fa-solid.fa-draw-polygon.me-1
                | Desenhar Área
              button#modal-btn-new-polygon-area.btn.btn-outline-warning.btn-sm.rounded-pill.fw-bold(type="button", title="Criar outra área separada")
                i.fa-solid.fa-plus.me-1
                | Nova Área
              button#modal-btn-undo-polygon.btn.btn-dark.btn-sm.rounded-circle(type="button", title="Desfazer (Ctrl+Z)", style="width: 32px; height: 32px; padding: 0;")
                i.fa-solid.fa-rotate-left
              button#modal-btn-redo-polygon.btn.btn-dark.btn-sm.rounded-circle(type="button", title="Refazer (Ctrl+Y)", style="width: 32px; height: 32px; padding: 0;")
                i.fa-solid.fa-rotate-right
              .d-flex.align-items-center.gap-1.ms-1(title="Escolher Cor da Área")
                label.small.text-light.mb-0 Cor:
                input#modal-polygon-color-picker.form-control.form-control-color.p-0.border-0.rounded-circle(type="color", value="#FFAA44", style="width: 28px; height: 28px; cursor: pointer;")
              button#modal-btn-clear-polygon.btn.btn-outline-danger.btn-sm.rounded-pill.ms-1(type="button")
                i.fa-solid.fa-eraser.me-1
                | Limpar
              span#modal-polygon-status-badge.badge.bg-dark.text-warning.border.border-warning.ms-auto Área: Todo o Mapa
            .flex-grow-1(style="min-height: 0;")
              #modal-right-panel-map.h-100(style="border-radius: 16px; overflow: hidden; border: 1px solid #3B3A48;")

          //- VISÃO 2: LISTA DE ANIMAIS CADASTRADOS
          #modal-panel-list.h-100.d-flex.flex-column.d-none
            .search-box-wrapper
              input#modalAnimalSearch.form-control.right-panel-search(type="text", placeholder="Pesquisar animais...")
              i.fa-solid.fa-magnifying-glass.search-icon

            .species-cards-scroll-area
              #modalAnimalCardsGrid.species-cards-grid

    //- Modal Overlay Split-Screen para Cadastro de Instituições.
    //- Mesmo layout/componentes da tela de cadastro de animais
    //- (.species-modal-fullscreen, .species-form-panel, .colored-pill-input-*).
    //- Mesmos campos e validações do formulário anterior (nome obrigatório).
    #ong-admin-modal.species-modal-fullscreen.d-none
      button#close-ong-modal-btn.btn-close.btn-close-white(type="button", aria-label="Fechar cadastro de Instituição", style="position: absolute; top: 20px; right: 25px; z-index: 3100;")
      .species-split-layout
        //- PAINEL ESQUERDO: FORMULÁRIO CADASTRAR INSTITUIÇÃO
        .species-form-panel
          .d-flex.align-items-center.justify-content-between.mb-3
            h2.species-title.mb-0 CADASTRAR INSTITUIÇÃO

          form#form-create-ong(action="/api/v1/ongs/", method="POST")
            input#ong-edit-id(type="hidden", name="ong_id")
            input.coord-lat(type="hidden", name="lat")
            input.coord-lng(type="hidden", name="lng")

            //- Linha 1: Latitude e Longitude (sincronizadas com o marcador)
            .row.g-3.mb-3
              .col-md-6
                label.species-form-label Latitude
                input.form-control.colored-pill-input-blue.input-lat(type="number", step="any", placeholder="-25.4284", required)
              .col-md-6
                label.species-form-label Longitude
                input.form-control.colored-pill-input-green.input-lng(type="number", step="any", placeholder="-49.2733", required)

            //- Linha 2: Nome e Foco
            .row.g-3.mb-3
              .col-md-6
                label.species-form-label Nome da Instituição
                input.form-control.colored-pill-input-bronze(type="text", name="nome", placeholder="Ex: SOS Mata Atlântica", required)
              .col-md-6
                label.species-form-label Área de Foco / Atuação
                input.form-control.colored-pill-input-crimson(type="text", name="foco", placeholder="Ex: Reforestamento, Proteção da Fauna")

            //- Linha 3: E-mail e Telefone
            .row.g-3.mb-3
              .col-md-6
                label.species-form-label E-mail de Contato
                input.form-control.colored-pill-input-blue(type="email", name="email", placeholder="contato@instituicao.org.br")
              .col-md-6
                label.species-form-label Telefone / WhatsApp
                input.form-control.colored-pill-input-green(type="text", name="telefone", placeholder="(41) 99999-9999")

            //- Linha 4: Descrição
            .row.g-3.mb-4
              .col-12
                label.species-form-label Descrição das Atividades
                textarea.form-control.colored-pill-input-bronze(name="descricao", rows="3", placeholder="Resumo dos projetos e formas de apoio...")

            //- Botões de Ação (idênticos aos do cadastro de animais)
            .d-flex.gap-3.mt-auto
              button.btn.btn-warning.fw-bold.rounded-pill.px-4.py-2(type="submit", style="background-color: #9C5B1C; border: none; color: #FFF;")
                i.fa-solid.fa-check.me-2
                | Salvar Instituição
              button.btn.btn-outline-secondary.rounded-pill.px-4.py-2.btn-cancel-ong-modal(type="button")
                i.fa-solid.fa-rotate-left.me-2
                | Limpar

        //- PAINEL DIREITO: MAPA DA LOCALIZAÇÃO (mesmo painel do animal)
        .species-display-panel
          .view-toggle-bar
            .view-toggle-btns
              button.toggle-btn.active(type="button")
                i.fa-solid.fa-map-location-dot
                | Mapa da Localização
          .h-100.d-flex.flex-column
            .map-location-controls.d-flex.align-items-center.gap-2.mb-2.p-2.rounded-3.flex-wrap(style="background-color: #2B2A33;")
              i.fa-solid.fa-circle-info.text-info
              span.small.text-light Clique no mapa ou arraste o marcador para definir a localização da Instituição.
            .flex-grow-1(style="min-height: 0;")
              #ong-right-panel-map.h-100(style="border-radius: 16px; overflow: hidden; border: 1px solid #3B3A48;")

    //- Modal Overlay Split-Screen para Cadastro de Áreas de Preservação.
    //- Mesmo layout/componentes da tela de animais + o MESMO editor de
    //- polígonos (desenhar / nova área / desfazer / refazer / cor / limpar).
    //- Mesmos campos e validações do formulário anterior (nome e tipo
    //- obrigatórios; `name="categoria"` segue o modelo ZonaPreservacao).
    #zona-admin-modal.species-modal-fullscreen.d-none
      button#close-zona-modal-btn.btn-close.btn-close-white(type="button", aria-label="Fechar cadastro de área de preservação", style="position: absolute; top: 20px; right: 25px; z-index: 3100;")
      .species-split-layout
        //- PAINEL ESQUERDO: FORMULÁRIO CADASTRAR ÁREA DE PRESERVAÇÃO
        .species-form-panel
          .d-flex.align-items-center.justify-content-between.mb-3
            h2.species-title.mb-0 CADASTRAR ÁREA DE PRESERVAÇÃO

          form#form-create-preservacao(action="/api/v1/zonas-preservacao/", method="POST")
            input#zona-edit-id(type="hidden", name="zona_id")
            input#zona-area-polygon-json-hidden(type="hidden", name="area_polygon_json")
            input.coord-lat(type="hidden", name="lat")
            input.coord-lng(type="hidden", name="lng")

            //- Linha 1: Latitude e Longitude (ponto de referência da área)
            .row.g-3.mb-3
              .col-md-6
                label.species-form-label Latitude
                input.form-control.colored-pill-input-blue.input-lat(type="number", step="any", placeholder="-27.5954", required)
              .col-md-6
                label.species-form-label Longitude
                input.form-control.colored-pill-input-green.input-lng(type="number", step="any", placeholder="-48.5480", required)

            //- Linha 2: Nome e Tipo
            .row.g-3.mb-3
              .col-md-6
                label.species-form-label Nome da Área
                input.form-control.colored-pill-input-bronze(type="text", name="nome", placeholder="Ex: Parque Nacional do Iguaçu", required)
              .col-md-6
                label.species-form-label Tipo de Preservação
                select.form-select.colored-pill-input-green(name="categoria", required)
                  option(value="Parque Nacional") Parque Nacional
                  option(value="Reserva Biológica") Reserva Biológica
                  option(value="Área de Proteção Ambiental") Área de Proteção Ambiental (APA)
                  option(value="Estação Ecológica") Estação Ecológica
                  option(value="Refúgio de Vida Silvestre") Refúgio de Vida Silvestre

            //- Linha 3: Descrição
            .row.g-3.mb-4
              .col-12
                label.species-form-label Descrição / Objetivos
                textarea.form-control.colored-pill-input-bronze(name="descricao", rows="3", placeholder="Descrição dos objetivos de conservação...")

            //- Botões de Ação (idênticos aos do cadastro de animais)
            .d-flex.gap-3.mt-auto
              button.btn.btn-warning.fw-bold.rounded-pill.px-4.py-2(type="submit", style="background-color: #9C5B1C; border: none; color: #FFF;")
                i.fa-solid.fa-check.me-2
                | Salvar Área de Preservação
              button.btn.btn-outline-secondary.rounded-pill.px-4.py-2.btn-cancel-zona-modal(type="button")
                i.fa-solid.fa-rotate-left.me-2
                | Limpar

        //- PAINEL DIREITO: MAPA + EDITOR DE POLÍGONOS (mesmos controles do animal)
        .species-display-panel
          .view-toggle-bar
            .view-toggle-btns
              button.toggle-btn.active(type="button")
                i.fa-solid.fa-map-location-dot
                | Mapa da Localização
          #zona-panel-map.h-100.d-flex.flex-column
            .map-location-controls.d-flex.align-items-center.gap-2.mb-2.p-2.rounded-3.flex-wrap(style="background-color: #2B2A33;")
              button#zona-btn-draw-polygon-mode.btn.btn-info.btn-sm.rounded-pill.fw-bold.text-dark(type="button")
                i.fa-solid.fa-draw-polygon.me-1
                | Desenhar Área
              button#zona-btn-new-polygon-area.btn.btn-outline-warning.btn-sm.rounded-pill.fw-bold(type="button", title="Criar outra área separada")
                i.fa-solid.fa-plus.me-1
                | Nova Área
              button#zona-btn-undo-polygon.btn.btn-dark.btn-sm.rounded-circle(type="button", title="Desfazer (Ctrl+Z)", style="width: 32px; height: 32px; padding: 0;")
