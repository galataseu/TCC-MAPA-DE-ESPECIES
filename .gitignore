# ==========================================
# 1. AMBIENTE, SEGREDOS E CREDENCIAIS (CRÍTICO)
# ==========================================
# Arquivos de variáveis de ambiente (contêm senhas, chaves de API e tokens)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Garante que o template/exemplo possa ser versionado no repositório
!.env.example
!.env.sample
!.env.template

# Chaves privadas, certificados e tokens de autenticação
*.pem
*.key
*.cert
*.cer
*.crt
*.pfx
*.p12
*.id_rsa
id_rsa*
credentials.json
client_secret*.json
service-account*.json
.npmrc

# ==========================================
# 2. PYTHON E DJANGO (BACKEND)
# ==========================================
# Bytecode e cache do interpretador
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/

# Ambientes virtuais
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
python/
backend/venv/
backend/.venv/

